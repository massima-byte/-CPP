# Copier vers .env et renseigner les valeurs depuis le canal de configuration MTN.
# Le .env n'est jamais servi au navigateur et doit rester hors du contrôle de version.
MTN_PRESTO_HOST=lnx-eva-master01.mtn.bj
MTN_PRESTO_PORT=8443
MTN_PRESTO_USER=itbireport_svc
MTN_PRESTO_PASSWORD=
MTN_PRESTO_CATALOG=hive
MTN_PRESTO_SCHEMA=mfs_bi
MTN_PRESTO_PROTOCOL=https

# Le certificat Presto MTN n'est pas approuvé par le magasin Python local observé.
# Préférer le chemin vers le certificat CA MTN ; "false" reproduit le connecteur local
# existant et conserve le chiffrement TLS sans valider l'identité du serveur.
MTN_PRESTO_TLS_VERIFY=false
MTN_PRESTO_QUERY_TIMEOUT=90s

# Fréquence de rafraîchissement Presto en arrière-plan (minimum 60 secondes).
MTN_MARKETING_REFRESH_INTERVAL_SECONDS=900
